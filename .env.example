# Kopieren nach .env.local (lokal) bzw. im Hosting-UI als Umgebungsvariablen setzen.
# NEXT_PUBLIC_* wird beim Build in den Code eingesetzt → nach jeder Änderung neu bauen/deployen.

# Kontaktformular: Formspree-kompatibler Endpoint (POST JSON, Accept: application/json).
# Leer lassen = Netlify Forms (funktioniert nur auf Netlify, Registrierung via public/__forms.html).
# Auf Vercel oder anderem Hosting MUSS ein Endpoint gesetzt sein.
# NEXT_PUBLIC_FORM_ENDPOINT=https://formspree.io/f/xxxxxxxx

# Newsletter-Anmeldung im Footer: Endpoint, der JSON { email, source } per POST annimmt.
# Leer lassen = Anmeldung per vorbereiteter E-Mail an info@castellana.ch (mailto).
# NEXT_PUBLIC_NEWSLETTER_ENDPOINT=https://formspree.io/f/yyyyyyyy
